// Cloudflare Workers 정적 사이트 배포: 빌드 결과(dist)를 그대로 올린다 (서버 코드 없음)
// 없는 파일은 404로 둔다. 예전에는 index.html을 대신 돌려줘(single-page-application),
// 배포 직후 옛 index.html이 지워진 옛 코드 파일을 찾으면 HTML을 코드로 받아 빈 화면에서 멈췄다.
// 캐시 규칙은 public/_headers.
{
  "name": "mk-u",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  }
}
